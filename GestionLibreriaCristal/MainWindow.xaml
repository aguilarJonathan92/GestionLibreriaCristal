<Window x:Class="GestionLibreriaCristal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GestionLibreriaCristal.ViewModels"
        Title="Librería Cristiana"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FDF2F8">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#FCE7F3" 
        BorderBrush="#F9A8D4" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo / Nombre -->
                <StackPanel Grid.Row="0" Margin="20,30,20,30">
                    <Border Background ="AliceBlue"
                    CornerRadius="20"
                    Padding="15"
                    HorizontalAlignment="Center"
                    Width="130" Height="130">
                        <Image Source="/Assets/logo.png"
                       Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="Librería Cristal" 
                       FontFamily="Candara"
                       FontSize="20" 
                       FontWeight="Bold"
                       Foreground="#4A2C3D" 
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0" />
                </StackPanel>

                <!-- Botones de navegación -->
                <StackPanel Grid.Row="1">
                    <Button Content="🏠  Inicio"       Style="{StaticResource NavButtonStyle}" />
                    <Button Content="👤  Clientes"
                        Style="{StaticResource NavButtonStyle}"
                        Click="Clientes_Click" />
                    <Button Content="📦  Productos"
                        Style="{StaticResource NavButtonStyle}"
                        Click="Productos_Click" />
                    <Button Content="🏷️  Categorías"
                        Style="{StaticResource NavButtonStyle}"
                        Click="Categorias_Click" />
                    <Button Content="🛒  Pedidos"    Style="{StaticResource NavButtonStyle}" />
                    <Button Content="🚚  Proveedores"
                        Style="{StaticResource NavButtonStyle}"
                        Click="Proveedores_Click" />
                    <Button Content="💰  Caja"       Style="{StaticResource NavButtonStyle}" />
                    <Button Content="⚙️  Ajustes"   Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <!-- Botón de apagar abajo -->
                <Button Grid.Row="2"
                    Content="⏻  Logout"
                    Style="{StaticResource LogoutButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="15,0,15,20" />  
            </Grid>
        </Border>

        <!-- ===== ÁREA DE CONTENIDO ===== -->
        <Border Grid.Column="1" Background="#FDF2F8">
            <ContentControl x:Name="ContenidoPrincipal" />
        </Border>
    </Grid>
</Window>