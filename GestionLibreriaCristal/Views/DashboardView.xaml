<UserControl x:Class="GestionLibreriaCristal.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionLibreriaCristal.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <UserControl.DataContext>
        <vm:DashboardViewModel />
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Dashboard"
                   FontFamily="Candara"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#4A2C3D"
                   Margin="0,0,0,20" />

        <!-- Grilla de 4 tarjetas -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Ventas del mes -->
            <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Ventas (últimos 30 días)" FontFamily="Candara" FontSize="16" FontWeight="Bold" Foreground="#4A2C3D" Margin="0,0,0,10" />
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding SeriesVentas}" XAxes="{Binding EjeXVentas}" YAxes="{Binding EjeYVentas}" />
                </Grid>
            </Border>

            <!-- 2. Productos más vendidos -->
            <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="12" Padding="15" Margin="10,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Top 5 Productos" FontFamily="Candara" FontSize="16" FontWeight="Bold" Foreground="#4A2C3D" Margin="0,0,0,10" />
                    <lvc:PieChart Grid.Row="1" Series="{Binding SeriesProductos}" />
                </Grid>
            </Border>

            <!-- 3. Deudas por cliente -->
            <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="12" Padding="15" Margin="0,10,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Clientes con deuda" FontFamily="Candara" FontSize="16" FontWeight="Bold" Foreground="#4A2C3D" Margin="0,0,0,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding ClientesConDeuda}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FDF2F8" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Nombre}" Foreground="#4A2C3D" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Saldo, StringFormat=C}" Foreground="#F38BA8" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 4. Stock bajo -->
            <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="12" Padding="15" Margin="10,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Productos para reponer" FontFamily="Candara" FontSize="16" FontWeight="Bold" Foreground="#4A2C3D" Margin="0,0,0,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding ProductosStockBajo}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FDF2F8" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Nombre}" Foreground="#4A2C3D" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding StockActual, StringFormat='Stock: {0}'}" Foreground="#F38BA8" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>