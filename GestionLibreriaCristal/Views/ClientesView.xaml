<UserControl x:Class="GestionLibreriaCristal.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionLibreriaCristal.ViewModels">

    <UserControl.DataContext>
        <vm:ClientesViewModel />
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Clientes"
                   FontFamily="Candara"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#4A2C3D"
                   Margin="0,0,0,20" />

        <!-- Barra de herramientas -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         BorderBrush="#F9A8D4"
                         BorderThickness="1"
                         Margin="0,0,15,0">
                    <TextBox.Resources>
                        <VisualBrush x:Key="Hint" AlignmentX="Left" Stretch="None" TileMode="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍  Buscar por nombre, teléfono o DNI..."
                                           Foreground="#9D7B8C"
                                           FontSize="14"
                                           Margin="10,0,0,0" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource Hint}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Checkbox "solo con deuda" -->
                <CheckBox Grid.Column="1"
                          Content="Solo con deuda"
                          IsChecked="{Binding MostrarSoloConDeuda}"
                          Foreground="#4A2C3D"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0" />

                <Button Grid.Column="2" Content="➕  Agregar"
                        Command="{Binding AgregarCommand}"
                        Background="#EC4899" Foreground="White"
                        Padding="18,10" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,8,0" />

                <Button Grid.Column="3" Content="✏️  Editar"
                        Command="{Binding EditarCommand}"
                        Background="#CBA6F7" Foreground="White"
                        Padding="18,10" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,8,0" />

                <Button Grid.Column="4" Content="🗑️  Eliminar"
                        Command="{Binding EliminarCommand}"
                        Background="#F38BA8" Foreground="White"
                        Padding="18,10" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- Lista -->
        <DataGrid Grid.Row="2"
                  Style="{StaticResource DataGridBaseStyle}"
                  ItemsSource="{Binding ClientesFiltrados}"
                  SelectedItem="{Binding ClienteSeleccionado}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre"    Binding="{Binding Nombre}"     Width="*"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Teléfono"  Binding="{Binding Telefono}"   Width="140"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="DNI/CUIT"  Binding="{Binding DniCuit}"    Width="130"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Saldo"     Binding="{Binding Saldo, StringFormat=C}" Width="120"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Estado"    Binding="{Binding EstadoCuenta}" Width="100"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
