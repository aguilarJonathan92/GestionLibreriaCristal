<Window x:Class="GestionLibreriaCristal.Views.PedidoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedido"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FDF2F8"
        FontFamily="Corbel">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock x:Name="TituloVentana"
                   Grid.Row="0"
                   Text="Nuevo pedido"
                   FontFamily="Candara"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#4A2C3D"
                   Margin="0,0,0,15" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============ DATOS DEL PEDIDO ============ -->
                <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Datos del pedido"
                                   FontFamily="Candara"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4A2C3D"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cliente *" Foreground="#4A2C3D" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Clientes}"
                                          SelectedItem="{Binding ClienteSeleccionado}"
                                          DisplayMemberPath="Nombre"
                                          Padding="8" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha" Foreground="#4A2C3D" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Fecha, Mode=OneWay, StringFormat='dd/MM/yyyy'}"
                                         IsReadOnly="True"
                                         Padding="8"
                                         Background="#F5F5F5"
                                         BorderBrush="#F9A8D4"
                                         BorderThickness="1" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ AGREGAR PRODUCTOS ============ -->
                <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Agregar productos"
                                   FontFamily="Candara"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4A2C3D"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Producto" Foreground="#4A2C3D" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Productos}"
                                          SelectedItem="{Binding ProductoSeleccionado}"
                                          Padding="8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Nombre, Mode=OneWay}" />
                                                <Run Text=" (Stock: " Foreground="#9D7B8C" />
                                                <Run Text="{Binding StockDisponible, Mode=OneWay}" Foreground="#9D7B8C" />
                                                <Run Text=") — " Foreground="#9D7B8C" />
                                                <Run Text="{Binding PrecioVenta, Mode=OneWay, StringFormat=C}" Foreground="#EC4899" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cantidad" Foreground="#4A2C3D" Margin="0,0,0,5" />
                                <TextBox Text="{Binding CantidadAgregar, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8" BorderBrush="#F9A8D4" BorderThickness="1"
                                         HorizontalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Precio" Foreground="#4A2C3D" Margin="0,0,0,5" />
                                <TextBox Text="{Binding PrecioAgregar, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         Padding="8" BorderBrush="#F9A8D4" BorderThickness="1" />
                            </StackPanel>

                            <Button Grid.Column="6"
                                    Content="➕  Agregar"
                                    Command="{Binding AgregarItemCommand}"
                                    Background="#EC4899" Foreground="White"
                                    Padding="20,8" BorderThickness="0"
                                    FontWeight="SemiBold" Cursor="Hand"
                                    VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ ITEMS DEL PEDIDO ============ -->
                <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Items del pedido"
                                   FontFamily="Candara"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4A2C3D"
                                   Margin="0,0,0,12" />

                        <DataGrid ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding ItemSeleccionado}"
                                  Style="{StaticResource DataGridBaseStyle}"
                                  MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto"    Binding="{Binding NombreProducto}" Width="*"
                                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                                <DataGridTextColumn Header="Cantidad"    Binding="{Binding Cantidad}" Width="100"
                                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                                <DataGridTextColumn Header="Precio unit." Binding="{Binding PrecioUnitario, StringFormat=C}" Width="130"
                                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                                <DataGridTextColumn Header="Subtotal"    Binding="{Binding Subtotal, StringFormat=C}" Width="130"
                                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✖"
                                                    Command="{Binding DataContext.QuitarItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    Background="Transparent"
                                                    Foreground="#F38BA8"
                                                    BorderThickness="0"
                                                    FontWeight="Bold"
                                                    Cursor="Hand" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ============ PAGO Y TOTALES ============ -->
                <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Pago y totales"
                                   FontFamily="Candara"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4A2C3D"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Columna izquierda: descuentos y pago -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Descuento (%)" Foreground="#4A2C3D" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding DescuentoPorcentaje, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                 Padding="8" BorderBrush="#F9A8D4" BorderThickness="1" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Descuento ($)" Foreground="#4A2C3D" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding DescuentoMonto, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                 Padding="8" BorderBrush="#F9A8D4" BorderThickness="1" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Forma de pago" Foreground="#4A2C3D" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding FormasPago}"
                                          SelectedItem="{Binding FormaPago}"
                                          Padding="8"
                                          Margin="0,0,0,12" />

                                <TextBlock Text="Pago ahora" Foreground="#4A2C3D" Margin="0,0,0,5" />
                                <TextBox Text="{Binding TotalPagado, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         Padding="8" BorderBrush="#F9A8D4" BorderThickness="1" />
                            </StackPanel>

                            <!-- Columna derecha: totales -->
                            <Border Grid.Column="2"
                                    Background="#FCE7F3"
                                    CornerRadius="10"
                                    Padding="15"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Subtotal:" Foreground="#4A2C3D" FontSize="14" />
                                        <TextBlock Text="{Binding Subtotal, StringFormat=C}"
                                                   Foreground="#4A2C3D" FontSize="14"
                                                   HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Descuento:" Foreground="#4A2C3D" FontSize="14" />
                                        <TextBlock Text="{Binding DescuentoTotal, StringFormat=C}"
                                                   Foreground="#F38BA8" FontSize="14"
                                                   HorizontalAlignment="Right" />
                                    </Grid>

                                    <Separator Background="#F9A8D4" Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="TOTAL:" Foreground="#4A2C3D"
                                                   FontSize="18" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Total, StringFormat=C}"
                                                   Foreground="#EC4899"
                                                   FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>

                                    <Separator Background="#F9A8D4" Margin="0,0,0,8" />

                                    <Grid>
                                        <TextBlock Text="Saldo pendiente:" Foreground="#4A2C3D" FontSize="14" />
                                        <TextBlock Text="{Binding Saldo, StringFormat=C}"
                                                   Foreground="#4A2C3D" FontSize="14" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ OPCIONES ============ -->
                <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Opciones"
                                   FontFamily="Candara"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4A2C3D"
                                   Margin="0,0,0,12" />

                        <CheckBox Content="Descontar stock ahora"
                                  IsChecked="{Binding DescontarStock}"
                                  Foreground="#4A2C3D"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,5" />
                        <TextBlock Text="Desmarcá si es un encargo que todavía no tenés en stock."
                                   Foreground="#9D7B8C"
                                   FontSize="12"
                                   Margin="25,0,0,12" />

                        <TextBlock Text="Observaciones" Foreground="#4A2C3D" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" BorderBrush="#F9A8D4" BorderThickness="1"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Botones inferiores -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Cancelar"
                    Click="Cancelar_Click"
                    Padding="25,12"
                    Background="#E5E5E5" Foreground="#4A2C3D"
                    BorderThickness="0" Cursor="Hand"
                    FontSize="14"
                    Margin="0,0,10,0" />
            <Button Content="💾  Guardar pedido"
                    Click="Guardar_Click"
                    Padding="25,12"
                    Background="#EC4899" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold"
                    FontSize="14" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>