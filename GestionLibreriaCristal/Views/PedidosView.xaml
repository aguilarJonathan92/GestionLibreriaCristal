<UserControl x:Class="GestionLibreriaCristal.Views.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionLibreriaCristal.ViewModels">

    <UserControl.DataContext>
        <vm:PedidosViewModel />
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Pedidos"
                   FontFamily="Candara"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#4A2C3D"
                   Margin="0,0,0,20" />

        <!-- Barra de herramientas -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         BorderBrush="#F9A8D4"
                         BorderThickness="1"
                         Margin="0,0,15,0">
                    <TextBox.Resources>
                        <VisualBrush x:Key="Hint" AlignmentX="Left" Stretch="None" TileMode="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍  Buscar por Nº o cliente..."
                                           Foreground="#9D7B8C"
                                           FontSize="14"
                                           Margin="10,0,0,0" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource Hint}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Grid.Column="1" Text="Desde:"
                           Foreground="#4A2C3D" VerticalAlignment="Center"
                           Margin="0,0,5,0" />
                <DatePicker Grid.Column="2"
                            SelectedDate="{Binding FechaDesde}"
                            Width="120"
                            Margin="0,0,15,0"
                            VerticalContentAlignment="Center" />

                <TextBlock Grid.Column="3" Text="Hasta:"
                           Foreground="#4A2C3D" VerticalAlignment="Center"
                           Margin="0,0,5,0" />
                <DatePicker Grid.Column="4"
                            SelectedDate="{Binding FechaHasta}"
                            Width="120"
                            Margin="0,0,15,0"
                            VerticalContentAlignment="Center" />

                <CheckBox Grid.Column="5"
                          Content="Solo con saldo"
                          IsChecked="{Binding MostrarSoloConSaldo}"
                          Foreground="#4A2C3D"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0" />

                <Button Grid.Column="6" Content="➕  Nuevo pedido"
                        Command="{Binding NuevoCommand}"
                        Background="#EC4899" Foreground="White"
                        Padding="18,10" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,8,0" />

                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <Button Content="✏️  Editar"
                            Command="{Binding EditarCommand}"
                            Background="#CBA6F7" Foreground="White"
                            Padding="18,10" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand"
                            Margin="0,0,8,0" />
                    <Button Content="🚫  Anular"
                            Command="{Binding AnularCommand}"
                            Background="#F38BA8" Foreground="White"
                            Padding="18,10" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lista -->
        <DataGrid Grid.Row="2"
                  Style="{StaticResource DataGridBaseStyle}"
                  ItemsSource="{Binding PedidosFiltrados}"
                  SelectedItem="{Binding PedidoSeleccionado}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nº"       Binding="{Binding Numero}"                              Width="70"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Fecha"    Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}"    Width="110"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Cliente"  Binding="{Binding Cliente.Nombre}"                      Width="*"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Total"    Binding="{Binding Total, StringFormat=C}"               Width="120"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Pagado"   Binding="{Binding TotalPagado, StringFormat=C}"         Width="120"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Saldo"    Binding="{Binding SaldoPendiente, StringFormat=C}"      Width="120"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Estado"   Binding="{Binding EstadoPago}"                          Width="100"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                <DataGridTextColumn Header="Pago"     Binding="{Binding FormaPago}"                           Width="130"
                                    ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>