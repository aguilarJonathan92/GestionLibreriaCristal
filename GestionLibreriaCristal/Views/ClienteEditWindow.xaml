<Window x:Class="GestionLibreriaCristal.Views.ClienteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliente"
        Height="700" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FDF2F8"
        FontFamily="Corbel">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TituloVentana"
                   Grid.Row="0"
                   Text="Nuevo cliente"
                   FontFamily="Candara"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#4A2C3D"
                   Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Nombre -->
                <TextBlock Text="Nombre completo *" Foreground="#4A2C3D" Margin="0,0,0,5" />
                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" BorderBrush="#F9A8D4" BorderThickness="1"
                         Margin="0,0,0,15" />

                <!-- Teléfono / DNI en 2 columnas -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teléfono" Foreground="#4A2C3D" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" BorderBrush="#F9A8D4" BorderThickness="1" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DNI / CUIT" Foreground="#4A2C3D" Margin="0,0,0,5" />
                        <TextBox Text="{Binding DniCuit, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" BorderBrush="#F9A8D4" BorderThickness="1" />
                    </StackPanel>
                </Grid>

                <!-- Email -->
                <TextBlock Text="Email" Foreground="#4A2C3D" Margin="0,0,0,5" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" BorderBrush="#F9A8D4" BorderThickness="1"
                         Margin="0,0,0,15" />

                <!-- Dirección -->
                <TextBlock Text="Dirección" Foreground="#4A2C3D" Margin="0,0,0,5" />
                <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" BorderBrush="#F9A8D4" BorderThickness="1"
                         Margin="0,0,0,15" />

                <!-- Saldo + Activo -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Saldo" Foreground="#4A2C3D" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Saldo, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                 Padding="8" BorderBrush="#F9A8D4" BorderThickness="1" />
                        <TextBlock Text="Positivo = debe. Negativo = a favor."
                                   Foreground="#9D7B8C"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <CheckBox Grid.Column="2"
                              Content="Activo"
                              IsChecked="{Binding Activo}"
                              Foreground="#4A2C3D"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,8" />
                </Grid>

                <!-- Notas -->
                <TextBlock Text="Notas" Foreground="#4A2C3D" Margin="0,0,0,5" />
                <TextBox Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" BorderBrush="#F9A8D4" BorderThickness="1"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar"
                    Click="Cancelar_Click"
                    Padding="20,10"
                    Background="#E5E5E5" Foreground="#4A2C3D"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,10,0" />
            <Button Content="Guardar"
                    Click="Guardar_Click"
                    Padding="20,10"
                    Background="#EC4899" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>