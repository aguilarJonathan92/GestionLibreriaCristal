<UserControl x:Class="GestionLibreriaCristal.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionLibreriaCristal.ViewModels">

    <UserControl.DataContext>
        <vm:ProductosViewModel />
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Productos"
                   FontFamily="Candara"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#4A2C3D"
                   Margin="0,0,0,20" />

        <!-- Barra de herramientas: buscador + botones -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Buscador -->
                <TextBox Grid.Column="0"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         BorderBrush="#F9A8D4"
                         BorderThickness="1"
                         Margin="0,0,15,0">
                    <TextBox.Resources>
                        <VisualBrush x:Key="Hint" AlignmentX="Left" Stretch="None" TileMode="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍  Buscar por nombre..."
                                           Foreground="#9D7B8C"
                                           FontSize="14"
                                           Margin="10,0,0,0" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource Hint}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Botón Agregar -->
                <Button Grid.Column="1"
                        Content="➕  Agregar"
                        Command="{Binding AgregarCommand}"
                        Background="#EC4899"
                        Foreground="White"
                        Padding="18,10"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,8,0" />

                <!-- Botón Editar -->
                <Button Grid.Column="2"
                        Content="✏️  Editar"
                        Command="{Binding EditarCommand}"
                        Background="#CBA6F7"
                        Foreground="White"
                        Padding="18,10"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,8,0" />

                <!-- Botón Eliminar -->
                <Button Grid.Column="3"
                        Content="🗑️  Eliminar"
                        Command="{Binding EliminarCommand}"
                        Background="#F38BA8"
                        Foreground="White"
                        Padding="18,10"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
            </Grid>
        </Border>

        <!-- Lista -->
        <DataGrid Grid.Row="2"
          Style="{StaticResource DataGridBaseStyle}"
          ItemsSource="{Binding ProductosFiltrados}"
          SelectedItem="{Binding ProductoSeleccionado}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre"     Binding="{Binding Nombre}"                          Width="*" />
                <DataGridTextColumn Header="Categoría"  Binding="{Binding Categoria.Nombre}"                 Width="140" />
                <DataGridTextColumn Header="Stock"      Binding="{Binding StockActual}"                      Width="80" />
                <DataGridTextColumn Header="Stock mín." Binding="{Binding StockMinimo}"                      Width="90" />
                <DataGridTextColumn Header="Costo"      Binding="{Binding CostoCompra, StringFormat=C}"      Width="110" />
                <DataGridTextColumn Header="Precio"     Binding="{Binding PrecioVenta, StringFormat=C}"      Width="110" />
                <DataGridTextColumn Header="Margen"     Binding="{Binding MargenUnitario, StringFormat=C}"   Width="110" />
                <DataGridTextColumn Header="Estado"     Binding="{Binding Estado}"                           Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>