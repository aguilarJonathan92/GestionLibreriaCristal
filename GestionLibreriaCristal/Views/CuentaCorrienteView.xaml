<UserControl x:Class="GestionLibreriaCristal.Views.CuentaCorrienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionLibreriaCristal.ViewModels">

    <UserControl.DataContext>
        <vm:CuentaCorrienteViewModel />
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Cuentas Corrientes"
                   FontFamily="Candara"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#4A2C3D"
                   Margin="0,0,0,20" />

        <!-- Contenido principal: 2 columnas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: lista de clientes con deuda -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Clientes con deuda"
                                   FontFamily="Candara"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4A2C3D"
                                   Margin="0,0,0,10" />

                        <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"
                                 FontSize="14"
                                 BorderBrush="#F9A8D4"
                                 BorderThickness="1">
                            <TextBox.Resources>
                                <VisualBrush x:Key="Hint" AlignmentX="Left" Stretch="None" TileMode="None">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍  Buscar cliente..."
                                                   Foreground="#9D7B8C"
                                                   FontSize="14"
                                                   Margin="8,0,0,0" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource Hint}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ClientesConDeuda}"
                             SelectedItem="{Binding ClienteSeleccionado}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <!-- Esto quita el fondo azul de selección por defecto y ajusta el espaciado -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="0">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- Cuando pasás el mouse, se pinta de un rosa muy suave -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FDF2F8" />
                                                    </Trigger>
                                                    <!-- Cuando seleccionás, se pinta de un rosa un poco más fuerte -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FBCFE8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                <Border Background="White"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,6"
                        BorderBrush="#F9A8D4"
                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                               Text="{Binding Nombre, Mode=OneWay}"
                               Foreground="#4A2C3D"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="1"
                               Text="{Binding Saldo, Mode=OneWay, StringFormat=C}"
                               Foreground="#F38BA8"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Columna derecha: detalle del cliente -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Nombre y saldo -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Detalle del cliente"
                                   FontFamily="Candara"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4A2C3D"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{Binding ClienteSeleccionado.Nombre, FallbackValue='Seleccioná un cliente'}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#4A2C3D" />

                        <TextBlock Text="{Binding ClienteSeleccionado.Saldo, StringFormat='Deuda actual: {0:C}'}"
                                   FontSize="14"
                                   Foreground="#F38BA8"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,15" />
                    </StackPanel>

                    <!-- Formulario de pago -->
                    <Border Grid.Row="1"
                            Background="#FCE7F3"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Registrar pago"
                                       FontFamily="Candara"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#4A2C3D"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Monto" Foreground="#4A2C3D" FontSize="12" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding MontoPago, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             Padding="6" BorderBrush="#F9A8D4" BorderThickness="1" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Descripción (opcional)" Foreground="#4A2C3D" FontSize="12" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding DescripcionPago, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6" BorderBrush="#F9A8D4" BorderThickness="1" />
                                </StackPanel>

                                <Button Grid.Column="4"
                                        Content="💰  Registrar"
                                        Command="{Binding RegistrarPagoCommand}"
                                        Background="#EC4899" Foreground="White"
                                        Padding="15,6" BorderThickness="0"
                                        FontWeight="SemiBold" Cursor="Hand"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Historial de movimientos -->
                    <TextBlock Grid.Row="2"
                               Text="Historial de movimientos"
                               FontFamily="Candara"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#4A2C3D"
                               Margin="0,0,0,8" />

                    <DataGrid Grid.Row="3"
                              Style="{StaticResource DataGridBaseStyle}"
                              ItemsSource="{Binding Movimientos}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding Fecha, Mode=OneWay, StringFormat='dd/MM/yyyy'}"
                                                Width="100"
                                                ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding Tipo, Mode=OneWay}"
                                                Width="90"
                                                ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                            <DataGridTextColumn Header="Descripción"
                                                Binding="{Binding Descripcion, Mode=OneWay}"
                                                Width="*"
                                                ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                            <DataGridTextColumn Header="Monto"
                                                Binding="{Binding MontoConSigno, Mode=OneWay, StringFormat=C}"
                                                Width="120"
                                                ElementStyle="{StaticResource DataGridTextColumnBaseStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>