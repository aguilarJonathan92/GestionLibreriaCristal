<Window x:Class="GestionLibreriaCristal.Views.CategoriaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categoría"
        Height="360" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FDF2F8"
        FontFamily="Corbel">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TituloVentana"
                   Grid.Row="0"
                   Text="Nueva categoría"
                   FontFamily="Candara"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#4A2C3D"
                   Margin="0,0,0,20" />

        <StackPanel Grid.Row="1">
            <!-- Nombre -->
            <TextBlock Text="Nombre *" Foreground="#4A2C3D" Margin="0,0,0,5" />
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8" BorderBrush="#F9A8D4" BorderThickness="1"
                     Margin="0,0,0,20" />

            <!-- Color -->
            <TextBlock Text="Color" Foreground="#4A2C3D" Margin="0,0,0,5" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" BorderBrush="#F9A8D4" BorderThickness="1" />

                <Border Grid.Column="1"
                        Width="40" Height="40"
                        CornerRadius="20"
                        Background="{Binding ColorHex}"
                        Margin="10,0,0,0" />
            </Grid>

            <TextBlock Text="Podés usar códigos HEX como #EC4899 (rosa), #89B4FA (celeste), #A6E3A1 (verde)."
                       Foreground="#9D7B8C"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar"
                    Click="Cancelar_Click"
                    Padding="20,10"
                    Background="#E5E5E5" Foreground="#4A2C3D"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,10,0" />
            <Button Content="Guardar"
                    Click="Guardar_Click"
                    Padding="20,10"
                    Background="#EC4899" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>